/// A conversation about one student, between the staff member who opened it
/// and that student's guardian — the parent portal's "Messages from the
/// school". A primary record, not a line item (the schema header's
/// distinction): it has its own lifecycle worth auditing, unlike a single
/// post within it.
model MessageThread {
  id         String   @id @default(uuid()) @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffId    String   @map("staff_id") @db.Uuid
  staff      Staff    @relation(fields: [staffId], references: [id], onDelete: Restrict)
  guardianId String   @map("guardian_id") @db.Uuid
  guardian   Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  subject    String   @db.VarChar(160)

  messages Message[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("MessageThreadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("MessageThreadUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("MessageThreadDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([staffId])
  @@index([guardianId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("message_threads")
}

/// One post within a thread — append-only, like AttendanceRecord: nobody
/// edits a sent message, only reads it (`readAt`).
model Message {
  id       String        @id @default(uuid()) @db.Uuid
  threadId String        @map("thread_id") @db.Uuid
  thread   MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String        @map("sender_id") @db.Uuid
  sender   User          @relation(fields: [senderId], references: [id], onDelete: Restrict)
  body     String        @db.Text
  readAt   DateTime?     @map("read_at")

  createdAt DateTime @default(now())

  @@index([threadId])
  @@index([senderId])
  @@map("messages")
}

/// A teacher's end-of-term remark on a student's record — the "Class
/// teacher's remark" line on a report card, actually authored rather than
/// computed from the average. One per (student, staff, term): a class
/// teacher and a principal can both leave one for the same term.
model Remark {
  id        String @id @default(uuid()) @db.Uuid
  studentId String @map("student_id") @db.Uuid
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staffId   String @map("staff_id") @db.Uuid
  staff     Staff   @relation(fields: [staffId], references: [id], onDelete: Restrict)
  termId    String @map("term_id") @db.Uuid
  term      Term    @relation(fields: [termId], references: [id], onDelete: Restrict)
  body      String @db.Text

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("RemarkCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("RemarkUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("RemarkDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([studentId, staffId, termId])
  @@index([termId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("remarks")
}

