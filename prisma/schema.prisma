model FileAsset {
  id         String @id @default(uuid()) @db.Uuid
  name       String @db.VarChar(200)
  category   String @db.VarChar(40)
  storageKey String @unique @map("storage_key") @db.VarChar(255) // object-store key/URL; the app never stores the file itself in Postgres
  sizeBytes  Int    @map("size_bytes")
  mimeType   String @map("mime_type") @db.VarChar(100)

  // Set only when category is something like 'learning_material' — a
  // teacher's upload tagged to the class+subject it belongs to, so a
  // student's portal can ask "materials for my class" directly. Every
  // other FileAsset use (certificates, submissions, gallery) leaves both
  // null; a generic file manager has no business requiring a class.
  classId   String?      @map("class_id") @db.Uuid
  class     SchoolClass? @relation(fields: [classId], references: [id], onDelete: SetNull)
  subjectId String?      @map("subject_id") @db.Uuid
  subject   Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  submissions      AssignmentSubmission[]
  galleryImages    GalleryImage[]
  certificates     Certificate[]
  studentDocuments StudentDocument[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("FileAssetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("FileAssetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("FileAssetDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([category])
  @@index([classId])
  @@index([subjectId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("file_assets")
}

// ============================================================================
// STUDENT INFORMATION SYSTEM — the parts of a student's record that live
// outside day-to-day academics: health, conduct, lifecycle events,
// certification, archived paperwork, biometric enrolment, and the narrative
// history that ties all of it together.
// ============================================================================

/// One row per student — the static health profile, not an event log.
/// Deliberately its own table rather than columns on Student: this data has
/// a different sensitivity class and a different access pattern (read by
/// the nurse and by nobody else, most days) from admission number and class.
model StudentMedicalProfile {
  id                    String      @id @default(uuid()) @db.Uuid
  studentId             String      @unique @map("student_id") @db.Uuid
  student               Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  bloodGroup            BloodGroup? @map("blood_group")
  genotype              Genotype?
  allergies             String?     @db.Text
  conditions            String?     @db.Text
  physicianName         String?     @map("physician_name") @db.VarChar(120)
  physicianPhone        String?     @map("physician_phone") @db.VarChar(20)
  emergencyContactName  String?     @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone String?     @map("emergency_contact_phone") @db.VarChar(20)
  insuranceProvider     String?     @map("insurance_provider") @db.VarChar(120)
  insuranceNo           String?     @map("insurance_no") @db.VarChar(40)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("StudentMedicalProfileCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("StudentMedicalProfileUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("StudentMedicalProfileDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("student_medical_profiles")
}

/// Many per student — a visit to the sick bay, not the profile itself.
model MedicalVisit {
  id           String   @id @default(uuid()) @db.Uuid
  studentId    String   @map("student_id") @db.Uuid
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  visitedOn    DateTime @map("visited_on") @db.Date
  reason       String   @db.VarChar(200)
  treatment    String?  @db.Text
  notes        String?  @db.Text
  recordedById String?  @map("recorded_by_staff_id") @db.Uuid
  recordedBy   Staff?   @relation("MedicalVisitRecordedByStaff", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("MedicalVisitCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("MedicalVisitUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("MedicalVisitDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([recordedById])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("medical_visits")
}

