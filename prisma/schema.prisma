/// Kept separate from Student on purpose: a student is one person across
/// their whole time at the school; an enrollment is that person's placement
/// in one class for one session. Promote a class to the next level and you
/// insert a new enrollment row — you never overwrite the old one.
model StudentEnrollment {
  id                String          @id @default(uuid()) @db.Uuid
  studentId         String          @map("student_id") @db.Uuid
  student           Student         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  classId           String          @map("class_id") @db.Uuid
  class             SchoolClass     @relation(fields: [classId], references: [id], onDelete: Restrict)
  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)

  promotionsFrom PromotionDecision[] @relation("PromotionFrom")
  promotionsTo   PromotionDecision[] @relation("PromotionTo")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("StudentEnrollmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("StudentEnrollmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("StudentEnrollmentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([studentId, academicSessionId])
  @@index([classId])
  @@index([academicSessionId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("student_enrollments")
}

