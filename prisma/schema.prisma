// ============================================================================
// IDENTITY & ACCESS — Role, Permission, User, Session, AuditLog, Notification
// ============================================================================

model Role {
  id    String    @id @default(uuid()) @db.Uuid
  key   String    @unique @db.VarChar(40) // e.g. PRINCIPAL, CLASS_TEACHER
  title String    @db.VarChar(80)
  scope RoleScope @default(GLOBAL)

  permissions   RolePermission[]
  users         User[]
  notifications Notification[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  deletedById String?      @map("deleted_by_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("roles")
}

model Permission {
  id     String @id @default(uuid()) @db.Uuid
  module String @db.VarChar(40)
  action String @db.VarChar(20)
  key    String @unique @db.VarChar(64) // "module.action" — denormalised for fast lookup, kept in sync with (module, action) by the app layer

  roles RolePermission[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  deletedById String?      @map("deleted_by_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([module, action])
  @@index([module])
  @@map("permissions")
}

/// Junction table: which permissions a role holds. No audit block — a grant
/// either exists or it doesn't; its history belongs in AuditLog, not in a
/// soft-deleted row sitting in the join table.
model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @map("permission_id") @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// The login identity. Deliberately separate from Staff/Student/Guardian —
/// not everyone with a person record can sign in, and the shape of "who can
/// log in" (username, password, role) has nothing to do with the shape of
/// "who this person is" (name, DOB, class). At most one of staffId /
/// studentId / guardianId is set, matching the role's scope.
model User {
  id           String @id @default(uuid()) @db.Uuid
  username     String @unique @db.VarChar(120)
  passwordHash String @map("password_hash") @db.VarChar(255)
  displayName  String @map("display_name") @db.VarChar(120)

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  staffId    String?   @unique @map("staff_id") @db.Uuid
  staff      Staff?    @relation(fields: [staffId], references: [id], onDelete: SetNull)
  studentId  String?   @unique @map("student_id") @db.Uuid
  student    Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  guardianId String?   @unique @map("guardian_id") @db.Uuid
  guardian   Guardian? @relation(fields: [guardianId], references: [id], onDelete: SetNull)

  /// Set only for a CLASS-scoped role (e.g. Class Teacher) — which class
  /// this particular login is homeroom teacher for. A role is reusable
  /// across many people; the class assignment is per person, so it lives
  /// here rather than on Role.
  homeroomClassId String?      @map("homeroom_class_id") @db.Uuid
  homeroomClass   SchoolClass? @relation("ClassHomeroomTeacher", fields: [homeroomClassId], references: [id], onDelete: SetNull)

  sessions        Session[]
  auditEntries    AuditLog[]
  aiConversations AiConversation[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("UserDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  usersCreated User[] @relation("UserCreatedBy")
  usersUpdated User[] @relation("UserUpdatedBy")
  usersDeleted User[] @relation("UserDeletedBy")

  // --- back-references: who created / updated / deleted each record ------
  // One array per (model, action) pair. Verbose by nature of the pattern
  // described at the top of this file — grouped in the same order as the
  // rest of the schema so a given block is easy to find.
  createdStaffs                Staff[]                @relation("StaffCreatedBy")
  updatedStaffs                Staff[]                @relation("StaffUpdatedBy")
  deletedStaffs                Staff[]                @relation("StaffDeletedBy")
  createdGuardians             Guardian[]             @relation("GuardianCreatedBy")
  updatedGuardians             Guardian[]             @relation("GuardianUpdatedBy")
  deletedGuardians             Guardian[]             @relation("GuardianDeletedBy")
  createdStudents              Student[]              @relation("StudentCreatedBy")
  updatedStudents              Student[]              @relation("StudentUpdatedBy")
  deletedStudents              Student[]              @relation("StudentDeletedBy")
  createdStudentEnrollments    StudentEnrollment[]    @relation("StudentEnrollmentCreatedBy")
  updatedStudentEnrollments    StudentEnrollment[]    @relation("StudentEnrollmentUpdatedBy")
  deletedStudentEnrollments    StudentEnrollment[]    @relation("StudentEnrollmentDeletedBy")
  createdApplications          Application[]          @relation("ApplicationCreatedBy")
  updatedApplications          Application[]          @relation("ApplicationUpdatedBy")
  deletedApplications          Application[]          @relation("ApplicationDeletedBy")
  createdLessonPlans           LessonPlan[]           @relation("LessonPlanCreatedBy")
  updatedLessonPlans           LessonPlan[]           @relation("LessonPlanUpdatedBy")
  deletedLessonPlans           LessonPlan[]           @relation("LessonPlanDeletedBy")
  createdAssignments           Assignment[]           @relation("AssignmentCreatedBy")
  updatedAssignments           Assignment[]           @relation("AssignmentUpdatedBy")
  deletedAssignments           Assignment[]           @relation("AssignmentDeletedBy")
  createdAssignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmissionCreatedBy")
  updatedAssignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmissionUpdatedBy")
  deletedAssignmentSubmissions AssignmentSubmission[] @relation("AssignmentSubmissionDeletedBy")
  createdScores                Score[]                @relation("ScoreCreatedBy")
  updatedScores                Score[]                @relation("ScoreUpdatedBy")
  deletedScores                Score[]                @relation("ScoreDeletedBy")
  createdCbtAttempts           CbtAttempt[]           @relation("CbtAttemptCreatedBy")
  updatedCbtAttempts           CbtAttempt[]           @relation("CbtAttemptUpdatedBy")
  deletedCbtAttempts           CbtAttempt[]           @relation("CbtAttemptDeletedBy")
  createdAttendanceRegisters   AttendanceRegister[]   @relation("AttendanceRegisterCreatedBy")
  updatedAttendanceRegisters   AttendanceRegister[]   @relation("AttendanceRegisterUpdatedBy")
  deletedAttendanceRegisters   AttendanceRegister[]   @relation("AttendanceRegisterDeletedBy")
  createdInvoices              Invoice[]              @relation("InvoiceCreatedBy")
  updatedInvoices              Invoice[]              @relation("InvoiceUpdatedBy")
  deletedInvoices              Invoice[]              @relation("InvoiceDeletedBy")
  createdPayments              Payment[]              @relation("PaymentCreatedBy")
  updatedPayments              Payment[]              @relation("PaymentUpdatedBy")
  deletedPayments              Payment[]              @relation("PaymentDeletedBy")
  createdLedgerEntries         LedgerEntry[]          @relation("LedgerEntryCreatedBy")
  updatedLedgerEntries         LedgerEntry[]          @relation("LedgerEntryUpdatedBy")
  deletedLedgerEntries         LedgerEntry[]          @relation("LedgerEntryDeletedBy")
  createdScholarships          Scholarship[]          @relation("ScholarshipCreatedBy")
  updatedScholarships          Scholarship[]          @relation("ScholarshipUpdatedBy")
  deletedScholarships          Scholarship[]          @relation("ScholarshipDeletedBy")
  createdPayrollRuns           PayrollRun[]           @relation("PayrollRunCreatedBy")
  updatedPayrollRuns           PayrollRun[]           @relation("PayrollRunUpdatedBy")
  deletedPayrollRuns           PayrollRun[]           @relation("PayrollRunDeletedBy")
  createdPayslips              Payslip[]              @relation("PayslipCreatedBy")
  updatedPayslips              Payslip[]              @relation("PayslipUpdatedBy")
  deletedPayslips              Payslip[]              @relation("PayslipDeletedBy")
  createdLeaveRequests         LeaveRequest[]         @relation("LeaveRequestCreatedBy")
  updatedLeaveRequests         LeaveRequest[]         @relation("LeaveRequestUpdatedBy")
  deletedLeaveRequests         LeaveRequest[]         @relation("LeaveRequestDeletedBy")
  createdBookLoans             BookLoan[]             @relation("BookLoanCreatedBy")
  updatedBookLoans             BookLoan[]             @relation("BookLoanUpdatedBy")
  deletedBookLoans             BookLoan[]             @relation("BookLoanDeletedBy")
  createdTransportAllocations  TransportAllocation[]  @relation("TransportAllocationCreatedBy")
  updatedTransportAllocations  TransportAllocation[]  @relation("TransportAllocationUpdatedBy")
  deletedTransportAllocations  TransportAllocation[]  @relation("TransportAllocationDeletedBy")
  createdHostelAllocations     HostelAllocation[]     @relation("HostelAllocationCreatedBy")
  updatedHostelAllocations     HostelAllocation[]     @relation("HostelAllocationUpdatedBy")
  deletedHostelAllocations     HostelAllocation[]     @relation("HostelAllocationDeletedBy")
  createdStockMovements        StockMovement[]        @relation("StockMovementCreatedBy")
  updatedStockMovements        StockMovement[]        @relation("StockMovementUpdatedBy")
  deletedStockMovements        StockMovement[]        @relation("StockMovementDeletedBy")
  createdNotices               Notice[]               @relation("NoticeCreatedBy")
  updatedNotices               Notice[]               @relation("NoticeUpdatedBy")
  deletedNotices               Notice[]               @relation("NoticeDeletedBy")
  createdMessageThreads        MessageThread[]        @relation("MessageThreadCreatedBy")
  updatedMessageThreads        MessageThread[]        @relation("MessageThreadUpdatedBy")
  deletedMessageThreads        MessageThread[]        @relation("MessageThreadDeletedBy")
  sentMessages                 Message[]
  createdRemarks                Remark[]               @relation("RemarkCreatedBy")
  updatedRemarks                Remark[]               @relation("RemarkUpdatedBy")
  deletedRemarks                Remark[]               @relation("RemarkDeletedBy")
  createdPages                 Page[]                 @relation("PageCreatedBy")
  updatedPages                 Page[]                 @relation("PageUpdatedBy")
  deletedPages                 Page[]                 @relation("PageDeletedBy")
  createdPosts                 Post[]                 @relation("PostCreatedBy")
  updatedPosts                 Post[]                 @relation("PostUpdatedBy")
  deletedPosts                 Post[]                 @relation("PostDeletedBy")
  createdEvents                Event[]                @relation("EventCreatedBy")
  updatedEvents                Event[]                @relation("EventUpdatedBy")
  deletedEvents                Event[]                @relation("EventDeletedBy")
  createdGalleryAlbums         GalleryAlbum[]         @relation("GalleryAlbumCreatedBy")
  updatedGalleryAlbums         GalleryAlbum[]         @relation("GalleryAlbumUpdatedBy")
  deletedGalleryAlbums         GalleryAlbum[]         @relation("GalleryAlbumDeletedBy")
  createdEnquiries             Enquiry[]              @relation("EnquiryCreatedBy")
  updatedEnquiries             Enquiry[]              @relation("EnquiryUpdatedBy")
  deletedEnquiries             Enquiry[]              @relation("EnquiryDeletedBy")
  createdFileAssets            FileAsset[]            @relation("FileAssetCreatedBy")
  updatedFileAssets            FileAsset[]            @relation("FileAssetUpdatedBy")
  deletedFileAssets            FileAsset[]            @relation("FileAssetDeletedBy")
  createdNotifications         Notification[]         @relation("NotificationCreatedBy")
  updatedNotifications         Notification[]         @relation("NotificationUpdatedBy")
  deletedNotifications         Notification[]         @relation("NotificationDeletedBy")

  // --- Student Information System audit trail -----------------------------
  createdStudentMedicalProfiles StudentMedicalProfile[] @relation("StudentMedicalProfileCreatedBy")
  updatedStudentMedicalProfiles StudentMedicalProfile[] @relation("StudentMedicalProfileUpdatedBy")
  deletedStudentMedicalProfiles StudentMedicalProfile[] @relation("StudentMedicalProfileDeletedBy")
  createdMedicalVisits          MedicalVisit[]          @relation("MedicalVisitCreatedBy")
  updatedMedicalVisits          MedicalVisit[]          @relation("MedicalVisitUpdatedBy")
  deletedMedicalVisits          MedicalVisit[]          @relation("MedicalVisitDeletedBy")
  createdBehaviourIncidents     BehaviourIncident[]     @relation("BehaviourIncidentCreatedBy")
  updatedBehaviourIncidents     BehaviourIncident[]     @relation("BehaviourIncidentUpdatedBy")
  deletedBehaviourIncidents     BehaviourIncident[]     @relation("BehaviourIncidentDeletedBy")
  createdPromotionDecisions     PromotionDecision[]     @relation("PromotionDecisionCreatedBy")
  updatedPromotionDecisions     PromotionDecision[]     @relation("PromotionDecisionUpdatedBy")
  deletedPromotionDecisions     PromotionDecision[]     @relation("PromotionDecisionDeletedBy")
  createdGraduationRecords      GraduationRecord[]      @relation("GraduationRecordCreatedBy")
  updatedGraduationRecords      GraduationRecord[]      @relation("GraduationRecordUpdatedBy")
  deletedGraduationRecords      GraduationRecord[]      @relation("GraduationRecordDeletedBy")
  createdTransferRecords        TransferRecord[]        @relation("TransferRecordCreatedBy")
  updatedTransferRecords        TransferRecord[]        @relation("TransferRecordUpdatedBy")
  deletedTransferRecords        TransferRecord[]        @relation("TransferRecordDeletedBy")
  createdWithdrawalRecords      WithdrawalRecord[]      @relation("WithdrawalRecordCreatedBy")
  updatedWithdrawalRecords      WithdrawalRecord[]      @relation("WithdrawalRecordUpdatedBy")
  deletedWithdrawalRecords      WithdrawalRecord[]      @relation("WithdrawalRecordDeletedBy")
  createdCertificates           Certificate[]           @relation("CertificateCreatedBy")
  updatedCertificates           Certificate[]           @relation("CertificateUpdatedBy")
  deletedCertificates           Certificate[]           @relation("CertificateDeletedBy")
  createdStudentDocuments       StudentDocument[]       @relation("StudentDocumentCreatedBy")
  updatedStudentDocuments       StudentDocument[]       @relation("StudentDocumentUpdatedBy")
  deletedStudentDocuments       StudentDocument[]       @relation("StudentDocumentDeletedBy")
  createdBiometricRecords       BiometricRecord[]       @relation("BiometricRecordCreatedBy")
  updatedBiometricRecords       BiometricRecord[]       @relation("BiometricRecordUpdatedBy")
  deletedBiometricRecords       BiometricRecord[]       @relation("BiometricRecordDeletedBy")

  @@index([roleId])
  @@index([homeroomClassId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("users")
}

/// A signed-in session / refresh token. Ephemeral by nature — no soft delete,
/// no version, no *_by columns: nobody "audits" who revoked their own
/// session, and a session table that outlives its purpose just accretes rows
/// forever, so a scheduled job purging expired ones is expected.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(45) // fits IPv6
  userAgent String?   @map("user_agent") @db.VarChar(255)
  createdAt DateTime  @default(now())
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Append-only. One line per state-changing action, written by the same
/// service-layer call that performs the change — never edited, never
/// soft-deleted (an audit log that can erase its own entries isn't one).
/// actorName/roleKey are deliberate snapshots, not live joins: history
/// should read the way it happened, not the way `actor` happens to be named
/// today.
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName String   @map("actor_name") @db.VarChar(120)
  roleKey   String   @map("role_key") @db.VarChar(40)
  action    String   @db.VarChar(64)
  detail    String   @db.Text
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_log")
}

/// Addressed to a role, not a specific user — matching the application's
/// "one signed-in persona per role" model. roleId null means broadcast to
/// everyone (the app's 'ALL' audience).
model Notification {
  id     String  @id @default(uuid()) @db.Uuid
  roleId String? @map("role_id") @db.Uuid
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  title  String  @db.VarChar(160)
  body   String  @db.Text
  read   Boolean @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("NotificationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("NotificationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([roleId])
  @@index([read])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("notifications")
}

// ============================================================================
// ACADEMIC STRUCTURE — session, term, class, subject, period (reference data)
// ============================================================================

model AcademicSession {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(20) // "2026/2027"

  terms             Term[]
  enrollments       StudentEnrollment[]
  invoices          Invoice[]
  scores            Score[]
  graduationRecords GraduationRecord[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  deletedById String?      @map("deleted_by_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@map("academic_sessions")
}

model Term {
  id                String          @id @default(uuid()) @db.Uuid
  academicSessionId String          @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  name              String          @db.VarChar(20) // "First Term"
  sequence          Int // 1, 2, 3 — for ordering without parsing the name
  startsOn          DateTime        @map("starts_on") @db.Date
  endsOn            DateTime        @map("ends_on") @db.Date
  isCurrent         Boolean         @default(false) @map("is_current")

  invoices Invoice[]
  scores   Score[]
