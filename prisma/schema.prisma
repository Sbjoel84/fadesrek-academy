  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("graduation_records")
}

model TransferRecord {
  id              String            @id @default(uuid()) @db.Uuid
  studentId       String            @map("student_id") @db.Uuid
  student         Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  direction       TransferDirection
  otherSchoolName String            @map("other_school_name") @db.VarChar(160)
  reason          String?           @db.Text
  transferStatus  TransferStatus    @default(PENDING) @map("transfer_status")
  requestedOn     DateTime          @map("requested_on") @db.Date
  effectiveOn     DateTime?         @map("effective_on") @db.Date

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("TransferRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("TransferRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("TransferRecordDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([transferStatus])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("transfer_records")
}

model WithdrawalRecord {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reason      WithdrawalReason
  detail      String?          @db.Text
  withdrawnOn DateTime         @map("withdrawn_on") @db.Date
  refundKobo  BigInt           @default(0) @map("refund_kobo")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("WithdrawalRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("WithdrawalRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("WithdrawalRecordDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("withdrawal_records")
}

model Certificate {
  id              String          @id @default(uuid()) @db.Uuid
  studentId       String          @map("student_id") @db.Uuid
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  certificateType CertificateType @map("certificate_type")
  serialNo        String          @unique @map("serial_no") @db.VarChar(30)
  issuedOn        DateTime        @map("issued_on") @db.Date
  fileAssetId     String?         @map("file_asset_id") @db.Uuid
  fileAsset       FileAsset?      @relation(fields: [fileAssetId], references: [id], onDelete: SetNull)
  revoked         Boolean         @default(false)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("CertificateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("CertificateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("CertificateDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([certificateType])
  @@index([fileAssetId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("certificates")
}

/// The student-specific document archive — birth certificates, passport
/// photos, previous school results — distinct from FileAsset (which is the
/// generic school-wide file manager): this table is what makes a stored
/// file *this student's document of that kind*, with its own verification
/// workflow.
model StudentDocument {
  id           String           @id @default(uuid()) @db.Uuid
  studentId    String           @map("student_id") @db.Uuid
  student      Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category     DocumentCategory
  fileAssetId  String           @map("file_asset_id") @db.Uuid
  fileAsset    FileAsset        @relation(fields: [fileAssetId], references: [id], onDelete: Restrict)
  verifiedById String?          @map("verified_by_staff_id") @db.Uuid
  verifiedBy   Staff?           @relation("StudentDocumentVerifiedByStaff", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedOn   DateTime?        @map("verified_on") @db.Date

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("StudentDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("StudentDocumentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("StudentDocumentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([category])
  @@index([fileAssetId])
  @@index([verifiedById])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("student_documents")
}

/// Never the biometric template itself — templateRef is a pointer/hash into
/// whatever purpose-built biometric device or vault actually holds the
/// fingerprint/face data. Raw biometric material has no business sitting in
/// the same database as fee balances and lesson plans; this table only
/// answers "is this student enrolled, in what modality, since when".
model BiometricRecord {
  id          String        @id @default(uuid()) @db.Uuid
  studentId   String        @map("student_id") @db.Uuid
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        BiometricType
  templateRef String        @map("template_ref") @db.VarChar(255)
  enrolledOn  DateTime      @map("enrolled_on") @db.Date
  deviceId    String?       @map("device_id") @db.VarChar(80)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("BiometricRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("BiometricRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("BiometricRecordDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([studentId, type])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("biometric_records")
}

/// Append-only narrative history, one row per notable thing that happened to
/// a student — enrolment, promotion, an incident, a certificate issued.
/// Distinct from AuditLog: AuditLog is a technical "who changed what record"
/// trail across the whole system; this is the biographical read a
/// registrar or parent actually wants — "what has happened to this child
/// here" — and is written deliberately by the handful of workflows that
/// produce a milestone, not by every field edit.
model StudentTimelineEvent {
  id          String           @id @default(uuid()) @db.Uuid
  studentId   String           @map("student_id") @db.Uuid
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  category    TimelineCategory
  title       String           @db.VarChar(160)
  description String?          @db.Text
  occurredOn  DateTime         @map("occurred_on") @db.Date

  createdAt   DateTime @default(now())
  createdById String?  @map("created_by_id") @db.Uuid

  @@index([studentId])
  @@index([occurredOn])
  @@index([category])
  @@map("student_timeline_events")
}

// ============================================================================
// AI ASSISTANT — conversation history for the Intelligent School OS layer.
// Distinct from AuditLog (technical "what changed") and Notification (things
// pushed at a role): this is the AI's own back-and-forth with one signed-in
// user, kept so a conversation has multi-turn memory and so the feedback
// loop has something to attach a thumbs up/down to. Every turn that actually
// touches data still gets its own AuditLog row via the audit module — this
// table is the conversational record, not the compliance one.
// ============================================================================

enum AiMessageRole {
  USER
  ASSISTANT
}

enum AiFeedback {
  UP
  DOWN
}

model AiConversation {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleKey String @map("role_key") @db.VarChar(40) // snapshot — what the user was authorised as when this started

  messages AiMessage[]

  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now()) @map("last_message_at")

  @@index([userId])
  @@map("ai_conversations")
}

/// Append-only, like AuditLog — a turn is never edited after the fact, only
/// annotated with feedback. `intent` is the tool name the gateway resolved
/// the turn to (null for denials/errors/plain clarifying questions); `params`
/// is the typed input Claude extracted for that tool; `resultSummary` is a
/// compact JSON snapshot of what the intent returned, kept here (not just in
/// AuditLog) so conversation history can be replayed without re-querying.
model AiMessage {
  id             String         @id @default(uuid()) @db.Uuid
  conversationId String         @map("conversation_id") @db.Uuid
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  content        String         @db.Text
  intent         String?        @db.VarChar(64)
  params         Json?
  resultSummary  Json?          @map("result_summary")
  feedback       AiFeedback?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([intent])
  @@map("ai_messages")
}
