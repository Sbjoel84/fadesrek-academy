  payeTotalKobo    BigInt           @map("paye_total_kobo")
  pensionTotalKobo BigInt           @map("pension_total_kobo")
  nhfTotalKobo     BigInt           @map("nhf_total_kobo")
  netTotalKobo     BigInt           @map("net_total_kobo")
