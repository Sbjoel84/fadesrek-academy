}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  studentId  String        @map("student_id") @db.Uuid
  student    Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoiceId  String?       @map("invoice_id") @db.Uuid
  invoice    Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  amountKobo BigInt        @map("amount_kobo")
  method     PaymentMethod
  reference  String        @unique @db.VarChar(30)
  gatewayRef String?       @map("gateway_ref") @db.VarChar(80)
  paidOn     DateTime      @map("paid_on") @db.Date
  reversed   Boolean       @default(false)

  ledgerEntries LedgerEntry[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("PaymentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("PaymentDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([studentId])
  @@index([invoiceId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("payments")
}

/// Double-entry: every payment writes a balanced debit/credit pair here.
/// Reversing a payment is a compensating entry, never an edit — the running
/// balance is always reconstructable from this table alone.
model LedgerEntry {
  id            String   @id @default(uuid()) @db.Uuid
  journalRef    String   @map("journal_ref") @db.VarChar(30)
  paymentId     String?  @map("payment_id") @db.Uuid
  payment       Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  debitAccount  String   @map("debit_account") @db.VarChar(40)
  creditAccount String   @map("credit_account") @db.VarChar(40)
  amountKobo    BigInt   @map("amount_kobo")
  postedOn      DateTime @map("posted_on") @db.Date

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("LedgerEntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("LedgerEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("LedgerEntryDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([journalRef])
  @@index([paymentId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("ledger_entries")
}

model Scholarship {
