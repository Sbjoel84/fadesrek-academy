/// One row per student × subject × component × term — never pre-summed.
/// Re-weighting a component (Settings) or re-marking one paper recomputes
/// every downstream total; it never triggers a migration, because no total
/// was ever stored.
model Score {
  id                String              @id @default(uuid()) @db.Uuid
  studentId         String              @map("student_id") @db.Uuid
  student           Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId         String              @map("subject_id") @db.Uuid
  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  componentId       String              @map("component_id") @db.Uuid
  component         AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)
  academicSessionId String              @map("academic_session_id") @db.Uuid
  academicSession   AcademicSession     @relation(fields: [academicSessionId], references: [id], onDelete: Restrict)
  termId            String              @map("term_id") @db.Uuid
  term              Term                @relation(fields: [termId], references: [id], onDelete: Restrict)
  value             Int

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("ScoreCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("ScoreUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("ScoreDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([studentId, subjectId, componentId, termId])
  @@index([subjectId])
  @@index([termId])
  @@index([academicSessionId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("scores")
}

model CbtExam {
  id            String  @id @default(uuid()) @db.Uuid
  subjectCode   String  @map("subject_code") @db.VarChar(10) // "MTH", or "ENTRANCE"
  questionCount Int     @map("question_count")
  durationMins  Int     @map("duration_mins")
  shuffle       Boolean @default(true)

  questions CbtQuestion[]
  attempts  CbtAttempt[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  deletedById String?      @map("deleted_by_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@map("cbt_exams")
}

model CbtQuestion {
  id     String  @id @default(uuid()) @db.Uuid
  examId String  @map("exam_id") @db.Uuid
  exam   CbtExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  stem   String  @db.Text

  options CbtQuestionOption[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  updatedById String?      @map("updated_by_id") @db.Uuid
  deletedById String?      @map("deleted_by_id") @db.Uuid
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@index([examId])
  @@map("cbt_questions")
}

/// Options normalised out of the question row (1NF) rather than kept as a
/// four-element array — `isCorrect` on the row itself means an option can be
/// reworded without invalidating every attempt already marked against it.
model CbtQuestionOption {
  id         String      @id @default(uuid()) @db.Uuid
  questionId String      @map("question_id") @db.Uuid
  question   CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sequence   Int
  text       String      @db.VarChar(200)
  isCorrect  Boolean     @default(false) @map("is_correct")

  createdAt DateTime @default(now())

  @@unique([questionId, sequence])
  @@map("cbt_question_options")
}

model CbtAttempt {
  id            String           @id @default(uuid()) @db.Uuid
  examId        String           @map("exam_id") @db.Uuid
  exam          CbtExam          @relation(fields: [examId], references: [id], onDelete: Restrict)
  candidateKind CbtCandidateKind @map("candidate_kind")
  studentId     String?          @map("student_id") @db.Uuid
  student       Student?         @relation(fields: [studentId], references: [id], onDelete: SetNull)
  applicationId String?          @map("application_id") @db.Uuid
  application   Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  questionOrder String[]         @map("question_order") @db.Uuid // frozen at start — see note below
  startedAt     DateTime         @map("started_at")
  deadline      DateTime
  submittedAt   DateTime?        @map("submitted_at")
  score         Int?
  percent       Int?
  attemptStatus CbtAttemptStatus @default(IN_PROGRESS) @map("attempt_status")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("CbtAttemptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("CbtAttemptUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("CbtAttemptDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)
  // Note: questionOrder is the one deliberate exception to "no repeating
  // groups" in this schema — it's a frozen, ordered list of question ids
  // fixed the moment the attempt starts (Postgres native uuid[]), not a
  // relation, because reshuffling on every render would let a candidate
  // reload for an easier paper, and a disputed attempt has to be
  // reconstructable exactly as it was sat.

  @@index([examId])
  @@index([studentId])
  @@index([applicationId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("cbt_attempts")
}

