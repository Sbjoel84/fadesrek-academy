/// A snapshot, not a live computation — persisted at run time so a later
/// change to a salary grade or the PAYE bands never rewrites history.
model Payslip {
  id                  String     @id @default(uuid()) @db.Uuid
  payrollRunId        String     @map("payroll_run_id") @db.Uuid
  payrollRun          PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  staffId             String     @map("staff_id") @db.Uuid
  staff               Staff      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  grossKobo           BigInt     @map("gross_kobo")
  basicKobo           BigInt     @map("basic_kobo")
  housingKobo         BigInt     @map("housing_kobo")
  transportKobo       BigInt     @map("transport_kobo")
  otherKobo           BigInt     @map("other_kobo")
  pensionEmployeeKobo BigInt     @map("pension_employee_kobo")
  pensionEmployerKobo BigInt     @map("pension_employer_kobo")
  nhfKobo             BigInt     @map("nhf_kobo")
  rentReliefKobo      BigInt     @map("rent_relief_kobo")
  taxableKobo         BigInt     @map("taxable_kobo")
  annualTaxKobo       BigInt     @map("annual_tax_kobo")
  netPayKobo          BigInt     @map("net_pay_kobo")

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("PayslipCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("PayslipUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("PayslipDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([payrollRunId, staffId])
  @@index([staffId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("payslips")
}

