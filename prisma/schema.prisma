/// The record of moving a student from one enrolment to the next — kept
/// separate from StudentEnrollment itself because a promotion is a
/// *decision* (who decided, when, on what outcome) about the boundary
/// between two enrolments, not a property of either one.
model PromotionDecision {
  id               String             @id @default(uuid()) @db.Uuid
  studentId        String             @map("student_id") @db.Uuid
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromEnrollmentId String             @map("from_enrollment_id") @db.Uuid
  fromEnrollment   StudentEnrollment  @relation("PromotionFrom", fields: [fromEnrollmentId], references: [id], onDelete: Restrict)
  toEnrollmentId   String?            @map("to_enrollment_id") @db.Uuid
  toEnrollment     StudentEnrollment? @relation("PromotionTo", fields: [toEnrollmentId], references: [id], onDelete: SetNull)
  outcome          PromotionOutcome
  remarks          String?            @db.Text
  decidedOn        DateTime           @map("decided_on") @db.Date

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  createdById String?      @map("created_by_id") @db.Uuid
  createdBy   User?        @relation("PromotionDecisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?      @map("updated_by_id") @db.Uuid
  updatedBy   User?        @relation("PromotionDecisionUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedById String?      @map("deleted_by_id") @db.Uuid
  deletedBy   User?        @relation("PromotionDecisionDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  status      RecordStatus @default(ACTIVE)
  version     Int          @default(1)

  @@unique([fromEnrollmentId])
  @@index([studentId])
  @@index([toEnrollmentId])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedById])
  @@map("promotion_decisions")
}

